// A.R.M.O.R.Y. user interface. Everything is sized for a light gun: large targets, no
// scrollbars (page buttons instead, plus the mouse wheel), tabs as big buttons in a column on the left.
// The Rust side (src/ui.rs) computes the item positions and pushes all state; this file only
// draws it and reports clicks.

export enum ItemKind { divider, label, button }

export enum StatusKind { unmonitored, on, off, fault }

export struct TabData {
    name: string,
    image: image,
    has-image: bool,
}

export struct ItemData {
    kind: ItemKind,
    x: length,
    y: length,
    width: length,
    height: length,
    text: string,
    image: image,
    has-image: bool,
    status: StatusKind,
    tile: bool,
}

export global Theme {
    in property <bool> dark: true;
    in property <length> font-size: 28px;
    in property <color> accent: #ffb400;
    in property <color> status-on: #2ecc71;
    in property <color> status-off: #8a8f98;
    in property <color> status-fault: #e74c3c;
    // Set per OS from Rust; generic names like "monospace" aren't resolved everywhere.
    in property <string> mono-font;

    out property <color> background: dark ? #14161b : #f2f3f5;
    out property <color> sidebar: dark ? #0b0d10 : #dfe2e8;
    out property <color> surface: dark ? #242a35 : #ffffff;
    out property <color> surface-pressed: dark ? #3b4455 : #cfd4dc;
    out property <color> border: dark ? #3a4253 : #b9bfca;
    out property <color> text: dark ? #f2f2f2 : #15171c;
    out property <color> text-muted: dark ? #9aa1ad : #5a6170;
    out property <color> on-accent: #15171c;
    out property <length> radius: 14px;
    out property <length> border-width: 3px;
}

// Base of everything clickable: a large rounded box with pressed/active/disabled looks.
component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked;

    border-radius: Theme.radius;
    border-width: Theme.border-width;
    border-color: active ? Theme.accent : Theme.border;
    background: !enabled ? Theme.surface.transparentize(0.7)
        : touch.pressed ? Theme.surface-pressed
        : active ? Theme.accent
        : Theme.surface;
    opacity: enabled ? 1 : 0.5;

    @children

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Triangle pointing up or down, `size` wide.
component Arrow inherits Path {
    in property <bool> up;
    in property <length> size;
    width: size;
    height: size * 0.7;
    viewbox-width: 100;
    viewbox-height: 70;
    commands: up ? "M 0 70 L 50 0 L 100 70 Z" : "M 0 0 L 50 70 L 100 0 Z";
    fill: Theme.text;
}

component PageButtons inherits VerticalLayout {
    in property <bool> can-up;
    in property <bool> can-down;
    callback page(int);

    Pressable {
        enabled: can-up;
        clicked => { root.page(-1); }
        Arrow {
            up: true;
            size: min(parent.width, parent.height) * 0.4;
        }
    }
    Pressable {
        enabled: can-down;
        clicked => { root.page(1); }
        Arrow {
            up: false;
            size: min(parent.width, parent.height) * 0.4;
        }
    }
}

component TabButton inherits Pressable {
    in property <TabData> tab;

    HorizontalLayout {
        padding: 12px;
        spacing: 16px;
        if tab.has-image: Image {
            source: tab.image;
            width: root.height - 24px;
            image-fit: contain;
        }
        Text {
            text: tab.name;
            font-size: Theme.font-size;
            font-weight: 700;
            color: root.active ? Theme.on-accent : Theme.text;
            horizontal-alignment: tab.has-image ? left : center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

// Image centered on top and label centered at the bottom; a single one is centered.
component ContentButton inherits Pressable {
    in property <ItemData> item;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        if item.has-image: Image {
            source: item.image;
            image-fit: contain;
            min-height: 0;
            vertical-stretch: 1;
        }
        if item.text != "": Text {
            text: item.text;
            font-size: Theme.font-size;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
            vertical-stretch: item.has-image ? 0 : 1;
        }
    }
}

component LabelItem inherits Rectangle {
    in property <ItemData> item;
    property <bool> monitored: item.status != StatusKind.unmonitored;
    property <color> status-color: item.status == StatusKind.on ? Theme.status-on
        : item.status == StatusKind.off ? Theme.status-off
        : Theme.status-fault;

    border-radius: Theme.radius;
    border-width: item.tile || monitored ? Theme.border-width : 0;
    border-color: monitored ? status-color : Theme.border;
    background: item.tile ? Theme.surface.transparentize(0.5) : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        if monitored: VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.font-size * 0.8;
                height: self.width;
                border-radius: self.width / 2;
                background: status-color;
            }
        }
        Text {
            text: item.text;
            font-size: Theme.font-size;
            color: Theme.text;
            horizontal-alignment: item.tile ? center : left;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

component DividerLine inherits VerticalLayout {
    alignment: center;
    Rectangle {
        height: 3px;
        background: Theme.border;
    }
}

component DividerItem inherits HorizontalLayout {
    in property <string> text;
    spacing: 20px;

    DividerLine { }
    if text != "": Text {
        text: root.text;
        font-size: Theme.font-size * 0.9;
        font-weight: 700;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
    if text != "": DividerLine { }
}

export component AppWindow inherits Window {
    in property <string> version;
    in property <[TabData]> tabs;
    in property <int> active-tab;
    in property <[ItemData]> items;
    in property <length> scroll-offset;
    in property <bool> show-scroll;
    in property <bool> can-page-up;
    in property <bool> can-page-down;
    in property <length> scroll-width: 100px;
    in property <length> spacing: 20px;
    in property <length> tab-width: 340px;
    in property <length> tab-height: 110px;
    // Non-empty: shows the error screen instead of the tab content.
    in property <string> config-error;
    // Non-empty: shows a message box over everything.
    in property <string> message-title;
    in property <string> message;

    callback tab-clicked(int);
    callback item-clicked(int);
    callback page(int);
    // Mouse wheel over the content; positive is up.
    callback scroll(length);
    callback content-resized(length, length);
    callback reload();
    callback quit();
    callback dismiss-message();

    title: "A.R.M.O.R.Y. " + version;
    icon: @image-url("../images/icon.png");
    background: Theme.background;
    default-font-size: Theme.font-size;
    min-width: 640px;
    min-height: 480px;

    HorizontalLayout {
        sidebar := Rectangle {
            property <length> inner-height: self.height - 2 * root.spacing;
            property <length> step: root.tab-height + root.spacing;
            property <bool> overflow: root.tabs.length * step - root.spacing > inner-height;
            property <length> list-height: overflow ? inner-height - step : inner-height;
            property <int> per-page: max(1, floor((list-height + root.spacing) / step));
            in-out property <int> first: 0;

            width: root.tab-width + 2 * root.spacing;
            background: Theme.sidebar;

            for tab[i] in root.tabs: TabButton {
                visible: i >= sidebar.first && i < sidebar.first + sidebar.per-page;
                x: root.spacing;
                y: root.spacing + (i - sidebar.first) * sidebar.step;
                width: root.tab-width;
                height: root.tab-height;
                tab: tab;
                active: i == root.active-tab;
                clicked => { root.tab-clicked(i); }
            }

            if overflow: HorizontalLayout {
                x: root.spacing;
                y: parent.height - root.spacing - root.tab-height;
                width: root.tab-width;
                height: root.tab-height;
                spacing: root.spacing;
                Pressable {
                    enabled: sidebar.first > 0;
                    clicked => { sidebar.first = max(0, sidebar.first - sidebar.per-page); }
                    Arrow {
                        up: true;
                        size: min(parent.width, parent.height) * 0.4;
                    }
                }
                Pressable {
                    enabled: sidebar.first + sidebar.per-page < root.tabs.length;
                    clicked => {
                        sidebar.first = min(root.tabs.length - sidebar.per-page, sidebar.first + sidebar.per-page);
                    }
                    Arrow {
                        up: false;
                        size: min(parent.width, parent.height) * 0.4;
                    }
                }
            }
        }

        // Clear separation between the tab column and the buttons.
        Rectangle {
            width: 6px;
            background: Theme.accent;
        }

        Rectangle {
            view := Rectangle {
                x: root.spacing;
                y: root.spacing;
                width: parent.width - 2 * root.spacing;
                height: parent.height - 2 * root.spacing;
                clip: true;

                changed width => { root.content-resized(self.width, self.height); }
                changed height => { root.content-resized(self.width, self.height); }

                // Behind the content: gets the wheel events the buttons don't take.
                TouchArea {
                    scroll-event(event) => {
                        root.scroll(event.delta-y);
                        accept
                    }
                }

                Rectangle {
                    y: -root.scroll-offset;
                    height: 0;
                    animate y { duration: 150ms; easing: ease-out; }

                    for item[i] in root.items: Rectangle {
                        x: item.x;
                        y: item.y;
                        width: item.width;
                        height: item.height;

                        if item.kind == ItemKind.divider: DividerItem {
                            text: item.text;
                        }
                        if item.kind == ItemKind.label: LabelItem {
                            item: item;
                        }
                        if item.kind == ItemKind.button: ContentButton {
                            item: item;
                            clicked => { root.item-clicked(i); }
                        }
                    }
                }

                if root.show-scroll: PageButtons {
                    x: parent.width - root.scroll-width;
                    width: root.scroll-width;
                    height: parent.height;
                    spacing: root.spacing;
                    can-up: root.can-page-up;
                    can-down: root.can-page-down;
                    page(direction) => { root.page(direction); }
                }
            }

            if root.config-error != "": Rectangle {
                background: Theme.background;
                VerticalLayout {
                    padding: 2 * root.spacing;
                    spacing: root.spacing;
                    Text {
                        text: "Configuration error";
                        font-size: Theme.font-size * 1.4;
                        font-weight: 700;
                        color: Theme.status-fault;
                    }
                    Text {
                        text: root.config-error;
                        font-family: Theme.mono-font;
                        font-size: max(14px, Theme.font-size * 0.6);
                        color: Theme.text;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: root.spacing;
                        height: 160px;
                        Pressable {
                            width: 320px;
                            clicked => { root.reload(); }
                            Text {
                                text: "Reload";
                                font-size: Theme.font-size;
                                color: Theme.text;
                            }
                        }
                        Pressable {
                            width: 320px;
                            clicked => { root.quit(); }
                            Text {
                                text: "Quit";
                                font-size: Theme.font-size;
                                color: Theme.text;
                            }
                        }
                    }
                }
            }
        }
    }

    if root.message != "": Rectangle {
        background: #000000b0;
        // Catches clicks next to the message box.
        TouchArea { }
        Rectangle {
            width: min(parent.width - 80px, 1200px);
            height: min(parent.height - 80px, 640px);
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 4px;
            border-color: Theme.status-fault;
            VerticalLayout {
                padding: 32px;
                spacing: 24px;
                Text {
                    text: root.message-title;
                    font-size: Theme.font-size * 1.3;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: root.message;
                    font-size: Theme.font-size * 0.8;
                    color: Theme.text;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                Pressable {
                    height: 160px;
                    clicked => { root.dismiss-message(); }
                    Text {
                        text: "OK";
                        font-size: Theme.font-size * 1.2;
                        font-weight: 700;
                        color: Theme.text;
                    }
                }
            }
        }
    }
}
